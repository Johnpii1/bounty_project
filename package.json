{
  "name": "bounty_project",
  "version": "1.0.0",
  "description": "A secure and flexible **on-chain bounty payout system** built in Solidity with full-stack MongoDB integration",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "forge test",
    "build": "forge build",
    "deploy:local": "forge script script/Deploy.s.sol --broadcast --rpc-url localhost",
    "db:start": "mongod",
    "dev:full": "concurrently \"npm run dev\" \"npm run db:start\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johnpii1/bounty_project.git"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "bounty",
    "web3",
    "mongodb",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Johnpii1/bounty_project/issues"
  },
  "homepage": "https://github.com/Johnpii1/bounty_project#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongodb": "^7.1.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}